---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="For owners — Alvina.am">
  <section class="container-page py-16 lg:py-24">
    <div class="max-w-3xl">
      <p class="text-alvina-green font-semibold mb-4">For apartment owners</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">List your apartment on Alvina.am without managing an account.</h1>
      <p class="mt-6 text-lg text-black/65 leading-8">Alvina.am is guest-facing. Owners do not register, log in or manage dashboards. We prepare and publish a clean apartment page using the photos, video, description, price and contact details you approve.</p>
    </div>

    <div class="mt-10 grid md:grid-cols-3 gap-6">
      <div class="card p-6"><p class="text-alvina-green font-bold">1</p><h2 class="mt-2 text-xl font-bold">Send materials</h2><p class="mt-3 text-black/60 leading-7">You send photos, video, apartment details, price and contact number.</p></div>
      <div class="card p-6"><p class="text-alvina-green font-bold">2</p><h2 class="mt-2 text-xl font-bold">Approve page</h2><p class="mt-3 text-black/60 leading-7">We prepare the page and publish only the information you approve.</p></div>
      <div class="card p-6"><p class="text-alvina-green font-bold">3</p><h2 class="mt-2 text-xl font-bold">Share link</h2><p class="mt-3 text-black/60 leading-7">Use your apartment link in Facebook, Instagram, WhatsApp, Telegram or other ads.</p></div>
    </div>

    <div class="mt-10 card p-8 lg:p-10">
      <h2 class="text-2xl font-bold">Interested in adding your apartment?</h2>
      <p class="mt-3 text-black/60 leading-7">Contact Alvina.am directly. We will review the materials and prepare a listing page if it matches the website quality requirements.</p>
      <a href="https://wa.me/37455518847" class="btn-primary mt-6">Contact via WhatsApp</a>
    </div>
  </section>
</BaseLayout>
