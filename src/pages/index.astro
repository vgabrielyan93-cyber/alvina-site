---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import { getListings } from '../lib/listings.js';
const apartments = getListings();
const featuredApartment = apartments[0];
---
<BaseLayout title="Alvina.am — Apartments for rent in Armenia">
  <section class="container-page py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-alvina-green font-semibold mb-4">Apartments for guests in Armenia</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">Find a comfortable apartment for your next stay.</h1>
        <p class="mt-6 text-lg text-black/65 leading-8">Alvina.am helps guests discover clean, comfortable apartments with real photos, clear details, pricing and direct contact with the host.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/listings" class="btn-primary">View apartments</a>
          <a href="#featured" class="btn-secondary">See featured stays</a>
        </div>
      </div>
      <div class="card overflow-hidden relative">
        {featuredApartment ? (
          <>
            <img src={featuredApartment.hero} alt={featuredApartment.title} class="h-[420px] w-full object-cover bg-black/5" />
            <div class="absolute bottom-4 left-4 right-4 rounded-3xl bg-white/90 backdrop-blur p-5 shadow-sm">
              <p class="text-sm text-black/50">Featured stay</p>
              <h2 class="text-xl font-bold">{featuredApartment.title}</h2>
            </div>
          </>
        ) : (
          <div class="flex h-[420px] items-center justify-center p-8 text-center text-black/50">
            Add your first listing in src/content/listings.
          </div>
        )}
      </div>
    </div>
  </section>

  <section id="featured" class="container-page">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <p class="text-alvina-green font-semibold">Featured</p>
        <h2 class="text-3xl font-bold">Available apartments</h2>
      </div>
      <a href="/listings" class="text-alvina-green font-semibold">View all →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {apartments.map((apartment) => <ApartmentCard apartment={apartment} />)}
    </div>
  </section>

  <section class="container-page mt-20">
    <div class="card p-8 lg:p-10 grid lg:grid-cols-3 gap-6">
      <div>
        <h2 class="text-2xl font-bold">Direct contact</h2>
        <p class="mt-3 text-black/60 leading-7">Call or message the host directly from the apartment page.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold">Clear details</h2>
        <p class="mt-3 text-black/60 leading-7">Photos, amenities, guest capacity, location area and price in one place.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold">Easy sharing</h2>
        <p class="mt-3 text-black/60 leading-7">Each apartment has its own clean link that can be shared anywhere.</p>
      </div>
    </div>
  </section>
</BaseLayout>
